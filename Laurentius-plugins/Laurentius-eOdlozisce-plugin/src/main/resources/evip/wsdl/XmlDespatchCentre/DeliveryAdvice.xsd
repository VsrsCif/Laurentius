<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:da="ws.dc.cif.vsrs.si/DeliveryAdvice" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="ws.dc.cif.vsrs.si/DeliveryAdvice">
	<xs:element name="DeliveryAdvice" type="da:DeliveryAdvice"/>
	<xs:complexType name="DeliveryAdvice">
		<xs:annotation>
			<xs:documentation> E - Vložišče </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Bin" type="xs:base64Binary" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="id" type="xs:int">
			<xs:annotation>
				<xs:documentation>EVIP id vročilnice</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="posiljkaId" type="xs:int" use="required">
			<xs:annotation>
				<xs:documentation>EVIP id izhodne pošiljke</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="datumVrocitve" type="xs:dateTime">
			<xs:annotation>
				<xs:documentation>Datum vročitve. Če povratnica ni bila vročena je datum null</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="datumSprejema" type="xs:dateTime" use="required">
			<xs:annotation>
				<xs:documentation>Datum sprejema vročilnice na sodišče</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="datumPrvegaObvestila" type="xs:dateTime">
			<xs:annotation>
				<xs:documentation>Datum prvega obvestila prejemniku.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="naslovnik">
			<xs:annotation>
				<xs:documentation>Naslovnik vročilnice</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="200"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="naslov">
			<xs:annotation>
				<xs:documentation>Naslov prejemnika vročilnice: ulica + hišna št.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="100"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="postStev">
			<xs:annotation>
				<xs:documentation>Poštna številka prejemnika</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:maxLength value="10"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="kraj">
			<xs:annotation>
				<xs:documentation>Kraj prejemnika vročilnice</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="60"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="tipVrocitve" type="xs:int">
			<xs:annotation>
				<xs:documentation>Tip vročilnice glede na vročitev: 1 – vročeno
2 – vročeno po fikciji
3 – vročitev neuspešna
4 - neznani dokument </xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="aplikSif">
			<xs:annotation>
				<xs:documentation>Sifra aplikacije, ki je "lastnica" vrocilnice</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:maxLength value="70"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="opravilnaStStevilka"  type="xs:int">
			<xs:annotation>
				<xs:documentation>Opravilna stevilka</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="opravilnaStLeto"  type="xs:int">
			<xs:annotation>
				<xs:documentation>Opravilna stevilka  - leto</xs:documentation>
			</xs:annotation>
		</xs:attribute>				
		<xs:attribute name="vpisnikKratica">
			<xs:annotation>
				<xs:documentation>Vpisnik kratica - sestavni del opravilne številke, ki se izpiše na kuverto</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="15"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>		
		<xs:attribute name="delovodnaSt">
			<xs:annotation>
				<xs:documentation>Delovodna številka - oznaka po kateri se vročilnica locira v arhivu</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="20"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="rStevilka">
			<xs:annotation>
				<xs:documentation>R stevilka pošiljke, kateri pripada povratnica (RR12345147SI)</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:maxLength value="13"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
                <xs:attribute name="razlogNevrocitve">
			<xs:annotation>
				<xs:documentation>Podatek imajo izpoljnene samo povratnice tipa 3. - Razlog neuspele vročitve, ki je prepisan
                                zaznamka pošte.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:maxLength value="200"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
</xs:schema>
