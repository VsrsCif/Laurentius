<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:dced="ws.dc.cif.vsrs.si/DespatchCentreEntryDocument" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="ws.dc.cif.vsrs.si/DespatchCentreEntryDocument">
	<xs:element name="DespatchCentreEntryDocument" type="dced:DespatchCentreEntryDocument"/>
	<xs:complexType name="DespatchCentreEntryDocument">
		<xs:annotation>
			<xs:documentation>Dokument izhodne pošiljke. Dokument ima lahko vsebino podano v Bin elementu ali 
                            pa CMIS id aplikRefIdPisanje - na podlagi katerega pride do vsebine.
                        </xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Bin" type="xs:base64Binary" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="id" type="xs:int">
			<xs:annotation>
				<xs:documentation>Id dokumenta v EVIP. Pri dodajanju pošiljke mora biti ta atribut prazen.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="posiljkaId" type="xs:int">
			<xs:annotation>
				<xs:documentation>Id pošiljke v EVIP. Pri dodajanju pošiljke mora biti ta atribut prazen.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="dokumentPot">
			<xs:annotation>
				<xs:documentation>Pot dokumenta v aplikaciji. </xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="1024"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="dokumentOpis" use="required">
			<xs:annotation>
				<xs:documentation>Opis dokumenta</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="4000"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="aplikRefIdPisanje">
			<xs:annotation>
				<xs:documentation>Id pošiljke v aplikaciji.  Namen ID- ja je pridobivanje binarne vsebine dokumenta iz aplikacije. Priporociljivo je, da je id sifriran, tako da 
			se do ostalih dokumentov ne da priti s poskusanjem</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="300"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="redovnaSt" type="xs:int">
			<xs:annotation>
				<xs:documentation>Redovna stevilka dokumenta</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="datoteka">
			<xs:annotation>
				<xs:documentation>Začasna datoteka v vloziscu</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="1024"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="mimeTip" default="application/pdf">
			<xs:annotation>
				<xs:documentation>Format zapisa datoteke (mime: application/pdf, image/png,...).Če je parameter prazen se upošteva, kot da je poslan pdf</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="120"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="steviloStrani" type="xs:integer">
			<xs:annotation>
				<xs:documentation>Stevilo strani. V primeru PDF datoteke. Ob oddaji pošiljke v EVIP -> EVIP prebere st strani in jih zapiše v podatkovni model. V ostalih formatih se zapiše vrednost -1</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="velikostDatoteke" type="xs:integer">
			<xs:annotation>
				<xs:documentation>Velikost datoteke v byte.  Ob oddaji pošiljke v EVIP -> EVIP zapiše velikost datoteke v podatkovni model</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="MD5">
			<xs:annotation>
				<xs:documentation>Zgostitvena vrednost MD5 datoteke.  Ob oddaji pošiljke v EVIP -> EVIP izračuna zgostitveno vrednost (MD5) datoteke in jo shrani v podatkovni model</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="32"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="dokumentTip" use="optional">
			<xs:annotation>
				<xs:documentation>Tip dokumenta (interni šifrant dokumentov) kot so: predlog=1, dopolnitevPredloga=2, umikVCeloti=3, delniUmik=4, ugovor=5,  odgovorNaUgovor=6, pritozba=7, vrocilnica=8, nevrocenaPosiljka=9, sklepVisjegaSodisca=10, neznano=11,...
                                Pri "internem vročanju" se ta atribut prepiše v Tip dokumenta dohodnega dokumenta.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:maxLength value="10"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
</xs:schema>
