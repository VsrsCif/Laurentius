<xs:schema xmlns:tns="ws.dc.cif.vsrs.si" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:scr="ws.dc.cif.vsrs.si/SCRControl" xmlns:dces="ws.dc.cif.vsrs.si/DeliveryAdvice" targetNamespace="ws.dc.cif.vsrs.si">
	<xs:import namespace="ws.dc.cif.vsrs.si/SCRControl" schemaLocation="../XmlCommon/SCRControl.xsd"/>
	<xs:import namespace="ws.dc.cif.vsrs.si/DeliveryAdvice" schemaLocation="DeliveryAdvice.xsd"/>
	<xs:element name="SCDespatchCentreModifyDCInputEntryResponse">
		<xs:annotation>
			<xs:documentation>Service parameters and results</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SCRControl" type="scr:SCRControl"/>
				<xs:element name="RData">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="ChangeData" minOccurs="0">
								<xs:complexType>
									<xs:attribute name="sodiSif" use="required">
										<xs:annotation>
											<xs:documentation>Spremeba sodisca</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:token">
												<xs:maxLength value="70"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="oddelek" use="required">
										<xs:annotation>
											<xs:documentation>spremeba oddelka</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:token">
												<xs:maxLength value="70"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="dodatnaOznakaVpisnika" use="optional">
										<xs:annotation>
											<xs:documentation>Dodatna oznaka vpisnika (knjiga)</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:token">
												<xs:maxLength value="10"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="oprStLeto" type="xs:integer" use="optional">
										<xs:annotation>
											<xs:documentation>Opravilna številka -> leto</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="oprStStevilka" type="xs:integer" use="optional">
										<xs:annotation>
											<xs:documentation>Opravilna številka -> zaporedna stevilka</xs:documentation>
										</xs:annotation>
									</xs:attribute>
									<xs:attribute name="vpisnikKratica" use="optional">
										<xs:annotation>
											<xs:documentation>Vpisnik kratica - sestavni del opravilne številke, ki se izpiše na kuverto</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="10"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
									<xs:attribute name="vpisnik">
										<xs:annotation>
											<xs:documentation>Sifra vpisnika, kjer je pošiljka nastala.</xs:documentation>
										</xs:annotation>
										<xs:simpleType>
											<xs:restriction base="xs:token">
												<xs:maxLength value="3"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:attribute>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="dohodniZaznamekId" type="xs:integer" use="required">
							<xs:annotation>
								<xs:documentation>Id posiljke kateri vrocilnica pripada</xs:documentation>
							</xs:annotation>
						</xs:attribute>
						<xs:attribute name="aplikSif" use="required">
							<xs:annotation>
								<xs:documentation>Sifra aplikacije, kjer je nstala soremeba statusa</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:token">
									<xs:maxLength value="70"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="action">
							<xs:annotation>
								<xs:documentation>Akcija   -Accepted, Rejected, aDeleted.ChangeData</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:token">
									<xs:maxLength value="70"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="rejectReason">
							<xs:annotation>
								<xs:documentation>Razlog zavrnitve  - Accepted, Rejected, Deleted</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:token">
									<xs:maxLength value="70"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="kadrSt" use="required">
							<xs:annotation>
								<xs:documentation>Kadrovska številka osebe, ki spreminja podatke</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:token">
									<xs:length value="7"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
