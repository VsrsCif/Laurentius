<?xml version="1.0" encoding="UTF-8"?>
<xs:schema  xmlns:tns="ws.dc.cif.vsrs.si" 
            targetNamespace="ws.dc.cif.vsrs.si" 
            xmlns:xs="http://www.w3.org/2001/XMLSchema" 
            xmlns:scr="ws.dc.cif.vsrs.si/SCRControl"
            xmlns:dce="ws.dc.cif.vsrs.si/DespatchCentreEntry">
    <xs:import namespace ="ws.dc.cif.vsrs.si/SCRControl" schemaLocation="../XmlCommon/SCRControl.xsd"/>
    <xs:import namespace ="ws.dc.cif.vsrs.si/DespatchCentreEntry" schemaLocation="DespatchCentreEntry.xsd"/>
    <xs:element name="SCDespatchCentreGetProcActReferencesResponse" >
        <xs:annotation>
            <xs:documentation>Service parameters and results</xs:documentation>
        </xs:annotation>
        <xs:complexType>
            <xs:sequence>
                <xs:element name="SCRControl" type="scr:SCRControl"/>
                <xs:element name="RData">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="DespatchCentreEntries" type="tns:DespatchCentreEntries" minOccurs="0"  maxOccurs="unbounded"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="DespatchCentreEntries">
        <xs:sequence>
            <xs:element name="DespatchCentreEntry" type="dce:DespatchCentreEntry"  minOccurs="0"  maxOccurs="unbounded" />
        </xs:sequence>
        <xs:attribute name="aplikIdPd" type="xs:token"  />
    </xs:complexType>
</xs:schema>
