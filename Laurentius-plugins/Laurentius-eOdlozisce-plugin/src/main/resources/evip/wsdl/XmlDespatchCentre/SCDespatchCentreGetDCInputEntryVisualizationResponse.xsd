<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:tns="ws.dc.cif.vsrs.si" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:scr="ws.dc.cif.vsrs.si/SCRControl" xmlns:dces="ws.dc.cif.vsrs.si/SCDespatchCentreGetDCInputEntryVisualizationResponse" targetNamespace="ws.dc.cif.vsrs.si">
	<xs:import namespace="ws.dc.cif.vsrs.si/SCRControl" schemaLocation="../XmlCommon/SCRControl.xsd"/>
	<xs:element name="SCDespatchCentreGetDCInputEntryVisualizationResponse">
		<xs:annotation>
			<xs:documentation>Service parameters and results</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SCRControl" type="scr:SCRControl"/>
				<xs:element name="RData">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Bin" type="xs:base64Binary" minOccurs="0"/>
						</xs:sequence>
						<xs:attribute name="dohodniZaznamekId" type="xs:integer" use="required">
							<xs:annotation>
								<xs:documentation>Id dohodne pošiljke v EVIP-u.</xs:documentation>
							</xs:annotation>
						</xs:attribute>
						<xs:attribute name="mimeTip">
							<xs:annotation>
								<xs:documentation>Format zapisa datoteke (mime: application/pdf, image/png,...)</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:maxLength value="120"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
