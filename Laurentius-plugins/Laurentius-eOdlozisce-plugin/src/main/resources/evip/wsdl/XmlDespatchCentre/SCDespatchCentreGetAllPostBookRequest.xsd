<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:tns="ws.dc.cif.vsrs.si" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:scc="ws.dc.cif.vsrs.si/SCControl" targetNamespace="ws.dc.cif.vsrs.si">
	<xs:import namespace="ws.dc.cif.vsrs.si/SCControl" schemaLocation="../XmlCommon/SCControl.xsd"/>
	<xs:element name="SCDespatchCentreGetAllPostBookRequest">
		<xs:annotation>
			<xs:documentation>Service parameters and results</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SCControl" type="scc:SCControl" minOccurs="0"/>
				<xs:element name="Data">
					<xs:complexType>
						<xs:attribute name="vlozId" type="xs:int">
							<xs:annotation>
								<xs:documentation>EVIP id vlozisca</xs:documentation>
							</xs:annotation>
						</xs:attribute>
						<xs:attribute name="sodiSif" >
							<xs:annotation>
								<xs:documentation>Sifra sodisca</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:length value="3"/>
				</xs:restriction>
			</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="aplikSif"  use="required">
							<xs:annotation>
								<xs:documentation>Sifra aplikacije</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:maxLength value="70"/>
				</xs:restriction>
			</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="katSt" use="required">
							<xs:annotation>
								<xs:documentation>Kadrovska stevilka</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:maxLength value="7"/>
				</xs:restriction>
			</xs:simpleType>
						</xs:attribute>
						<xs:attribute name="sifPodatkovniVirUdelezenec" type="xs:token"/>
						<xs:attribute name="idUdelezenec" type="xs:token"/>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
